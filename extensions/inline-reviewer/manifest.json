{
  "manifest_version": 3,
  "name": "Review Pilot Inline Reviewer",
  "version": "0.1.0",
  "description": "Shows a review-ticket snapshot beside GitHub pull request files. Does not publish reviews.",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://github.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Review Pilot inline reviewer"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": ["lib/query-capture.js", "lib/placement.js", "lib/sha-gate.js", "lib/prepare.js", "lib/debug.js", "lib/diff-nav.js", "content/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
